# Rust потребує більшого стеку головної задачі, ніж C (за замовчуванням 3K).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# 1 кГц тік, щоб затримка 1 мс у циклі заліза справді була 1 мс.
CONFIG_FREERTOS_HZ=1000

# Три NTP-сервери, як у C++-версії.
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# Цикл заліза на ядрі 1 (APP_CPU), як loop() в Arduino; бот і Wi-Fi — на ядрі 0.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y

# Два TLS-з'єднання з Telegram (long-poll і відправка): буфери mbedtls
# виділяються лише на час обміну, щоб вистачало heap.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
